# Скопіюй у .env і заповни справжніми значеннями. .env у gitignore, ніколи не комітиться.

# Anthropic API ключ для запуску Claude Code всередині devcontainer
ANTHROPIC_API_KEY=sk-ant-...

# Базова адреса сайту: canonical, hreflang, OG-теги (app/lib/site.ts). Без неї —
# продакшн-адреса Vercel. Переїзд на власний домен = зміна цієї змінної у Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log level (debug, info, warn, error)
LOG_LEVEL=info

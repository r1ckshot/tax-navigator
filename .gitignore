# Секрети
.env
.env.*
!.env.example

# Build / deps.
# Без слеша на кінці: `worktree.symlinkDirectories` кладе в кожен worktree
# СИМЛІНК на node_modules головного репо, а патерн зі слешем матчить лише теки —
# симлінки висіли б untracked після кожного `claude --worktree`.
node_modules
.next/
.next-verify/
dist/
# Curated release artefacts: the release workflow writes them on the runner,
# and a local dry-run of the same step writes them here. They belong to a run,
# not to the repo — the reviewed copy lives in docs/releases/.
.release/
*.tsbuildinfo

# Вивід Playwright: звіт, трейси і `-actual`/`-diff` картинки одного прогону.
# Самі еталони (visual/__screenshots__/) трекаються — без них нема з чим
# порівнювати.
test-results/
playwright-report/
blob-report/

# Крах-дампи Git Bash на Windows
*.stackdump

# Сесії / credentials
*.session*
session.json

# Матеріали курсу (вкладені git-репозиторії)
docs/course/

# Local tier (персональні override, не для команди).
# `**/` обов'язкове: патерн зі слешем усередині git якорить на корінь репо, тож
# без нього вкладений mcp/evidence-guard/.claude/ лишався невиключеним.
**/.claude/settings.local.json
**/.claude/*.local.md

# Worktrees. `.worktrees/` — ручні `git worktree add`;
# `.claude/worktrees/` — те, що створює `claude --worktree`.
.worktrees/
.claude/worktrees/

# Приватне: нотатки, чернетки здачі, tg-mining pipeline (дані + протокол)
docs/notes/
docs/capstones/
research/tg-mining/

# Кеш вердиктів TaskCompleted-гейта: вердикт живе рівно один прогін команди.
.claude/.cache/

# evals: пісочниці й транскрипти прогонів (артефакти, не джерела)
evals/tmp/
evals/promptfoo/node_modules/
evals/**/results.json
__pycache__/

# Історія прогонів звірки — робочі дані, не код
scripts/rules-change-monitor/data/

# Шаблон файла секретів колектора. Справжній файл живе лише на сервері
# (шлях — змінна TG_ENV_FILE), права 600, власник — користувач runner-а.
# У git і в образ не потрапляє ніколи.

# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Результат `node login.ts <файл>`: повний доступ до акаунта, поводитись як з паролем.
TG_SESSION=

# Username або числовий id із `node main.ts chats`, через кому.
TG_CHATS=

# Необов'язкові, показано дефолти.
# WINDOW_WEEKS=4
# CYCLE_WEEKDAY=1
# CYCLE_HOUR_UTC=6
# MAX_FLOOD_WAIT_SECONDS=600
# В образі матриця вже лежить тут; задавати лише поза образом.
# RULES_PATH=/app/rules/rules.2026.json

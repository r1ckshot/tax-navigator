{
  "name": "tax-navigator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/worktree-ports.mjs -- next dev",
    "build": "next build",
    "start": "node scripts/worktree-ports.mjs -- next start",
    "ports": "node scripts/worktree-ports.mjs",
    "test": "vitest run && npm run test:arch",
    "test:watch": "vitest",
    "test:arch": "depcruise app",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:visual": "node scripts/worktree-ports.mjs -- playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "dependency-cruiser": "^18.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
